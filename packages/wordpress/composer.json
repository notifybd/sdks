{
  "name": "notifybd/notify-wordpress",
  "description": "Notify for WordPress: send OTP and transactional messages through Notify, and receive signed delivery webhooks.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "staabm/annotate-pull-request-from-checkstyle": "^1.8"
  },
  "scripts": {
    "test": "phpunit --bootstrap vendor/autoload.php tests",
    "lint": "phpcs --standard=WordPress --report=checkstyle notify-bd | cs2pr"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
