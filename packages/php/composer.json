{
  "name": "notifybd/notify-php",
  "description": "Official PHP SDK for the Notify transactional messaging API: app-first OTP and transactional messages with SMS fallback, delivery tracking and webhook verification.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "notify",
    "sms",
    "otp",
    "bangladesh",
    "transactional",
    "webhook",
    "sdk"
  ],
  "homepage": "https://github.com/notifybd/notify-php",
  "support": {
    "issues": "https://github.com/notifybd/sdks/issues",
    "source": "https://github.com/notifybd/notify-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^1.11 || ^2.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "staabm/annotate-pull-request-from-checkstyle": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "NotifyBd\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NotifyBd\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse",
    "cs": "php-cs-fixer fix --dry-run --diff --format=checkstyle | cs2pr"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
