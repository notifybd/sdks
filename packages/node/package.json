{
  "name": "@notifybd/sdk",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the Notify transactional messaging API: send OTP and transactional messages app-first with SMS fallback, track delivery, verify webhooks.",
  "keywords": ["notify", "sms", "otp", "bangladesh", "transactional", "webhook", "sdk"],
  "license": "MIT",
  "homepage": "https://github.com/notifybd/sdks/tree/main/packages/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notifybd/sdks.git",
    "directory": "packages/node"
  },
  "bugs": { "url": "https://github.com/notifybd/sdks/issues" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
